{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.3"
    }
  },
  "routes": [
    {
      "src": "/admin/dashboard",
      "dest": "/api/index.php"
    },
    {
      "src": "/admin/logout",
      "dest": "/api/index.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
