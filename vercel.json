{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/process_signup",
      "destination": "/api/process_signup.php"
    },
    {
      "source": "/api/process_login",
      "destination": "/api/process_login.php"
    },
    {
      "source": "/api/process_order",
      "destination": "/api/process_order.php"
    },
    {
      "source": "/api/logout",
      "destination": "/api/logout.php"
    },
    {
      "source": "/api/admin_dashboard",
      "destination": "/api/admin_dashboard.php"
    },
    {
      "source": "/api/dashboard",
      "destination": "/api/dashboard.php"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1.php"
    }
  ]
}
