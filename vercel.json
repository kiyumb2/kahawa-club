{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.3"
    }
  },
  "routes": [
    {
      "src": "/admin/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
