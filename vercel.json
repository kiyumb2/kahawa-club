{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/admin/dashboard",
      "dest": "/api/admin_dashboard.php"
    },
    {
      "src": "/admin/logout",
      "dest": "/api/admin_logout.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.php"
    }
  ]
}
